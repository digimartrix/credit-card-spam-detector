# Local email OTP mode: dev displays codes on-screen; email sends real messages.
OTP_MODE=dev

# Email sender. Use apps_script to send through the Google Apps Script web app,
# or gmail_smtp to use Gmail SMTP with an App Password.
EMAIL_PROVIDER=apps_script

# Apps Script web app URL and shared secret (keep the secret server-side).
APPS_SCRIPT_URL=https://script.google.com/macros/s/your-deployment-id/exec
APPS_SCRIPT_SECRET=replace-with-the-same-random-secret-stored-in-script-properties

# Gmail SMTP alternative. Use a Google App Password, not your Gmail password.
GMAIL_USERNAME=your-project-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
EMAIL_FROM_NAME=EXPayshield

# Optional SMTP settings; Gmail defaults are shown.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Keep a stable random value for signed Flask sessions.
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Email OTP retry and live fraud-alert throttling.
OTP_RESEND_COOLDOWN_SECONDS=30
EMAIL_ALERT_COOLDOWN_SECONDS=300
